{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "violet":      { "$value": "#6B4EFF", "$type": "color", "$description": "Primary brand. Links, focus rings, logo accent." },
    "violet-deep": { "$value": "#5B3FE6", "$type": "color" },
    "violet-soft": { "$value": "#ECE8FF", "$type": "color" },
    "coral":       { "$value": "#FF5C7A", "$type": "color", "$description": "Call to action only. One per screen." },
    "coral-deep":  { "$value": "#E8456A", "$type": "color" },
    "lime":        { "$value": "#C8F55A", "$type": "color", "$description": "Live / highlight accent. Never body text." },
    "ink":         { "$value": "#0F1222", "$type": "color", "$description": "Darkest surface. Footer, app chrome, dark page." },
    "slate":       { "$value": "#171B2E", "$type": "color" },
    "steel":       { "$value": "#262B45", "$type": "color" },
    "cloud":       { "$value": "#F6F7FB", "$type": "color" },
    "mist":        { "$value": "#E6E8F2", "$type": "color" },
    "white":       { "$value": "#FFFFFF", "$type": "color" }
  },
  "status": {
    "light": { "ok": "#1A9E6B", "warn": "#C98A12", "serious": "#E0502B", "critical": "#C9264A" },
    "dark":  { "ok": "#3DBA85", "warn": "#E0A93A", "serious": "#F0744F", "critical": "#F05C7A" }
  },
  "chart": {
    "categorical": {
      "light": ["#5B3FE6", "#D63A5B", "#0A9A94", "#B06A12"],
      "dark":  ["#8A74F5", "#E8607E", "#1FA39C", "#C4872A"],
      "$description": "Fixed order, never cycled. Validated with the dataviz six-checks validator on #FCFCFB and #171B2E surfaces."
    },
    "sequential-hue": "#6B4EFF",
    "diverging": { "negative": "#D63A5B", "mid": "#9A9FB5", "positive": "#0A9A94" }
  },
  "font": {
    "display": { "$value": "Outfit", "$type": "fontFamily", "$description": "Headlines, wordmark, hero numbers. Weights 500-800." },
    "body":    { "$value": "Inter",   "$type": "fontFamily", "$description": "Body, UI, tables. Weights 400-600." },
    "mono":    { "$value": "JetBrains Mono", "$type": "fontFamily", "$description": "Figures in tables, code, IDs." }
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "20px", "xl": "28px", "pill": "999px" },
  "space":  { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "20": "80px" }
}
